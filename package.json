{
  "name": "ridealong2",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "danny",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "NODE_ENV=production nodemon server.js",
    "compile:sass": "sass public/scss/main.scss public/css/style.css",
    "compress:css": "cleancss -O2 -o public/css/bundle.css public/css/style.css",
    "build:css": "npm-run-all compile:sass compress:css",
    "watch:css": "sass --watch public/scss/main.scss:public/css/style.css",
    "watch:js": "parcel watch ./public/js/index.js --out-dir ./public/js --out-file bundle.js --public-url /js",
    "build:js": "parcel build ./public/js/index.js --out-dir ./public/js --out-file bundle.js --public-url /js"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1",
    "mongoose": "^6.13.8",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.11",
    "pug": "^3.0.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "stripe": "^22.2.0",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "npm-run-all": "^4.1.5",
    "parcel-bundler": "^1.12.5",
    "prettier": "^3.8.1",
    "sass": "^1.69.5"
  },
  "engines": {
    "node": "24.x"
  }
}
