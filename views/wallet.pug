extends base
block content
  main.app-shell
    .page
      .balance-card
        .label Available balance
        .amount(data-wallet-balance)= walletBalance
        .header-actions
          button.btn.btn-light(type='button' data-open-dialog='topupDialog') Add funds
      .split-2
        section.surface
          .surface-head
            h3 Recent activity
          if activity.length
            each item in activity
              .list-row
                div
                  h4= item.title
                  p= item.note
                .text-right
                  .money(class=item.positive ? 'is-credit' : 'is-debit')= item.amountLabel
                  p= item.when
          else
            .empty
              h3 No wallet activity
              p Top up to keep fare payments ready.
        aside
          section.surface
            .surface-head
              h3 Quick top-up
            .surface-body
              .amount-grid
                button.chip(type='button' data-topup-amount='500') ETB 500
                button.chip(type='button' data-topup-amount='1000') ETB 1,000
                button.chip(type='button' data-topup-amount='2000') ETB 2,000
                button.chip(type='button' data-topup-amount='5000') ETB 5,000
              .form-group.mt-md
                label(for='customAmount') Custom amount
                input#customAmount(type='number' min='1' placeholder='ETB' data-topup-custom)
              button.btn.btn-primary.btn-block(type='button' data-open-dialog='topupDialog') Top up now
          section.surface.mt-lg
            .surface-body
              h3 Security
              p.text-secondary Payments are stored on your account. Card and Telebirr checkout can plug into this same top-up API.

  .dialog-backdrop#topupDialog
    .dialog
      h3 Add funds
      p.text-secondary Choose a method. The balance is credited on this account immediately for development.
      .form-group.mt-md
        label(for='method') Method
        select#method(data-topup-method)
          option(value='Telebirr') Telebirr
          option(value='CBE Birr') CBE Birr
          option(value='Visa / Mastercard') Visa / Mastercard
      .header-actions.mt-lg
        button.btn.btn-secondary(type='button' data-close-dialog) Close
        button.btn.btn-primary(type='button' data-confirm-topup) Continue
